#!/usr/bin/env python3
"""
Telegram Archive CLI entry point.
This script can be executed directly or symlinked to a location in PATH.
"""

import os
import sys

# Put the repository root (which holds the telegram_archive package) on the path
script_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, script_dir)

# Import and run the main CLI
from telegram_archive.__main__ import main  # noqa: E402 — sys.path insertion above must run first

if __name__ == "__main__":
    sys.exit(main())

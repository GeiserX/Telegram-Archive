#!/usr/bin/env python3
"""
Telegram Archive CLI entry point.
This script can be executed directly or symlinked to a location in PATH.
"""

import os
import sys

# Add src directory to Python path
script_dir = os.path.dirname(os.path.abspath(__file__))
src_path = os.path.join(script_dir, "src")
sys.path.insert(0, script_dir)

# Import and run the main CLI
from src.__main__ import main  # noqa: E402 — sys.path insertion above must run first

if __name__ == "__main__":
    sys.exit(main())
